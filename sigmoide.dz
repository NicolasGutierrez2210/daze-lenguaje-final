puntos = [];
x = -6;
en_juego (x <= 6) {
    y = sigmoide(x);
    puntos = puntos + [{"x": x, "y": y}];
    x = x + 1;
}
proyectar(puntos);
pizarra lineas(puntos) {
    eje_x = "x";
    eje_y = "y";
    titulo = "Funcion Sigmoide";
    color = "royalblue";
    guardar = "salidas/funcion_sigmoide.png";
}
