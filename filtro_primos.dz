# Punto 5: Filtro funcional de datos primos (goles, dorsales y columnas numericas)

# Funcion (tactica) pura que filtra funcionalmente una lista dejando solo primos
tactica filtrar_primos(lista) {
    primos = [];
    ronda (x en lista) {
        si (es_primo(x)) {
            primos = primos + [x];
        }
    }
    resultado primos;
}

plantilla = fichar("datos/rendimiento_jugadores.csv");

# 1. FILTRO FUNCIONAL EN LISTAS PARA TODAS LAS COLUMNAS NUMERICAS
lista_dorsales = [];
lista_goles = [];
lista_asistencias = [];
lista_minutos = [];
lista_pases = [];
lista_recuperaciones = [];

ronda (fila en plantilla) {
    lista_dorsales = lista_dorsales + [fila["dorsal"]];
    lista_goles = lista_goles + [fila["goles"]];
    lista_asistencias = lista_asistencias + [fila["asistencias"]];
    lista_minutos = lista_minutos + [fila["minutos"]];
    lista_pases = lista_pases + [fila["pases_clave"]];
    lista_recuperaciones = lista_recuperaciones + [fila["recuperaciones"]];
}

proyectar("=== FILTRO FUNCIONAL DE PRIMOS EN LISTAS ===");
proyectar("Dorsales primos encontrados:");
proyectar(filtrar_primos(lista_dorsales));

proyectar("Goles primos encontrados:");
proyectar(filtrar_primos(lista_goles));

proyectar("Asistencias primas encontradas:");
proyectar(filtrar_primos(lista_asistencias));

proyectar("Minutos primos encontrados:");
proyectar(filtrar_primos(lista_minutos));

proyectar("Pases clave primos encontrados:");
proyectar(filtrar_primos(lista_pases));

proyectar("Recuperaciones primas encontradas:");
proyectar(filtrar_primos(lista_recuperaciones));

# 2. FILTRO TABULAR CON PIPELINE (|>) POR GOLES Y DORSALES PRIMOS
proyectar("=== TABLA: JUGADORES CON CANTIDAD DE GOLES PRIMA ===");
tabla_goles_primos = plantilla
    |> convocar(dorsal, nombre, posicion, goles, asistencias)
    |> descartar(es_primo(goles));
proyectar(tabla_goles_primos);

proyectar("=== TABLA: JUGADORES CON DORSAL PRIMO ===");
tabla_dorsales_primos = plantilla
    |> convocar(dorsal, nombre, posicion, goles, asistencias)
    |> descartar(es_primo(dorsal));
proyectar(tabla_dorsales_primos);
